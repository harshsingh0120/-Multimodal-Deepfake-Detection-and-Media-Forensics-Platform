# ============================================================================
#  Multimodal Deepfake Detection & Media Forensics Platform — environment
#  Copy this file to `backend/.env` (and `frontend/.env` for the VITE_ var).
#  NEVER commit a real .env. No secret is required to run the core engine.
# ============================================================================

# --- Server ---
APP_NAME="Multimodal Deepfake Forensics Platform"
HOST=0.0.0.0
PORT=8000

# Comma-separated list of frontend origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Upload limits / security ---
MAX_UPLOAD_MB=100
# Where transient results/reports are cached.
DATA_DIR=./data
# How long (seconds) a result/report is retained in memory before pruning.
RESULT_TTL_SECONDS=3600

# --- Analysis tunables ---
VIDEO_MAX_FRAMES=24
FRAME_MAX_SIDE=720
AUDIO_SR=16000
AUDIO_SEGMENT_SEC=1.0
# Temperature for confidence calibration (>1 = less over-confident).
CALIBRATION_TEMPERATURE=1.3

# --- Optional: override the bundled ffmpeg (normally leave blank) ---
# FFMPEG_BINARY=/usr/bin/ffmpeg

# --- Optional: trained deep-model plugins (leave blank to use the forensic engine) ---
# Hugging Face image-classification model id (or local dir) for the image branch.
# Requires `pip install torch transformers`. Example (real/fake face ViT):
#   IMAGE_MODEL_ID=dima806/deepfake_vs_real_image_detection
IMAGE_MODEL_ID=
# Which output index is the "fake" class. -1 = auto-detect from the model's id2label.
# Some checkpoints ship a REVERSED id2label — dima806 is one, so set this to 0 for it.
IMAGE_MODEL_FAKE_INDEX=-1
# Generic torch checkpoints (implement inference in app/analyzers/model_plugin.py):
IMAGE_MODEL_PATH=
AUDIO_MODEL_PATH=
SYNC_MODEL_PATH=

# --- Frontend (Vite) : put this in frontend/.env ---
# Base URL the React app uses to reach the API.
VITE_API_BASE=http://localhost:8000
